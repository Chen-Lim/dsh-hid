{
  "name": "dsh-plugin-peripheral-server",
  "version": "1.0.0",
  "description": "DeepSeek Harness Cordis plugin for physical HID peripheral status bridge and input routing",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "keywords": [
    "deepseek-harness",
    "cordis",
    "plugin",
    "hid",
    "peripheral"
  ],
  "author": "Chen-Lim",
  "license": "MIT",
  "dependencies": {
    "@dsh-hid/protocol": "workspace:*",
    "cordis": "^4.0.0-rc.12",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.14",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
