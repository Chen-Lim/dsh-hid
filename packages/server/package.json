{
  "name": "dsh-plugin-peripheral-server",
  "version": "1.0.0",
  "description": "DeepSeek Harness Cordis plugin for physical HID peripheral status bridge and input routing",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "tsc -b && node -e \"const fs=require('fs');const p='dist/client.js';if(fs.existsSync(p)){fs.writeFileSync(p, fs.readFileSync(p,'utf8').replace(/export\\s*\\{\\s*\\};?/g, ''));}\"",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "keywords": [
    "deepseek-harness",
    "cordis",
    "plugin",
    "hid",
    "peripheral"
  ],
  "author": "Chen-Lim",
  "license": "MIT",
  "dependencies": {
    "@dsh-hid/protocol": "workspace:*",
    "cordis": "^4.0.0-rc.12",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.14",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
